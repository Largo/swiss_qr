#!/usr/bin/env ruby
# frozen_string_literal: true

# Prints the Swiss QR-bills in images/PDFs (or a payload on stdin) as JSON.
# Run "swiss_qr --help" for the options.

lib = File.expand_path("../lib", __dir__)
$LOAD_PATH.unshift(lib) if File.directory?(lib) && !$LOAD_PATH.include?(lib)

require "swiss_qr/cli"

exit SwissQr::CLI.new.run(ARGV)
